# WebMaker — Environment Variables
# Copy this file to `.env` and fill in your own keys.
# Never commit a real `.env` file.

# ---- AI providers (set the ones you use) ------------------------------------
GEMINI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
GPT_API_KEY=

# Model overrides (optional — defaults are set in code / webmaker.yaml)
# GEMINI_MODEL=gemini-2.0-flash
# CLAUDE_MODEL=claude-sonnet-4-6
# DEEPSEEK_MODEL=deepseek-chat
# GPT_MODEL=gpt-4.1

# ---- Local WordPress demo admin (used only on first local setup) ------------
WP_ADMIN_USER=admin
WP_ADMIN_PASS=change-me-local-only
WP_ADMIN_EMAIL=admin@localhost.local

# ---- Optional local WordPress / DB overrides --------------------------------
# WP_PORT=8080
# DB_PORT=3307
# DB_HOST=127.0.0.1
# DB_NAME=webmaker_wp
# DB_USER=root
# DB_PASSWORD=
# WEB_HOST=localhost
# WEB_PORT=8080
# LOG_LEVEL=INFO
# AI_PROVIDER=auto
